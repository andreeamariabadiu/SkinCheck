<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_luxury_card"
    android:padding="16dp"
    android:layout_marginBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Nume și Brand -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvBrand"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Brand"
                android:textSize="11sp"
                android:letterSpacing="0.1"
                android:textColor="@color/jo_accent"
                android:layout_marginBottom="2dp" />

            <TextView
                android:id="@+id/tvName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nume Produs"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/jo_primary" />
        </LinearLayout>

        <!-- Rating Text -->
        <TextView
            android:id="@+id/tvRating"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rating"
            android:textSize="12sp"
            android:textColor="@color/jo_secondary"
            android:layout_marginEnd="12dp" />

        <!-- Favorite Icon -->
        <ImageView
            android:id="@+id/imgFav"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@android:drawable/btn_star_big_on"
            android:contentDescription="Favorite"
            app:tint="@color/skin_gold"
            android:layout_marginEnd="10dp"
            android:visibility="gone" />

        <!-- Status Dot -->
        <View
            android:id="@+id/viewDot"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/bg_pill" />

    </LinearLayout>

</LinearLayout>