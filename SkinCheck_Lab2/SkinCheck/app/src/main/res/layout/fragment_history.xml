<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/jo_background">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="I S T O R I C · S C A N Ă R I"
        android:textSize="12sp"
        android:letterSpacing="0.3"
        android:textColor="@color/jo_accent"
        android:layout_marginBottom="6dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Produse Analizate"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="@color/jo_primary"
        android:layout_marginBottom="16dp" />

    <!-- ChipGroup pentru Filtre -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="16dp">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true"
            app:selectionRequired="false">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipFav"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Favorite" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipGreen"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sigur" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipYellow"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Moderat" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipRed"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Atenție" />

        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Mesaj pentru listă goală -->
    <TextView
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Niciun produs găsit în această categorie."
        android:textSize="14sp"
        android:textColor="@color/jo_secondary"
        android:gravity="center"
        android:visibility="gone"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="16dp" />

    <!-- RecyclerView pentru Istoric -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvHistory"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingBottom="24dp" />

</LinearLayout>